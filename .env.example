# ==========================================
# THUMBNAIL ANTI-SLOP — ENVIRONMENT CONFIG
# ==========================================

# 1. Multimodal AI Director Configuration (Visual Understanding)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_DETAIL=high

# 2. Gemini Visual Auditor Configuration (Optional Complementary Auditor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_VISUAL_AUDITOR=false

# 3. Provider Cascade: auto | openai | gemini | local
# - auto: Prefers OpenAI Director if configured, then Gemini, then deterministic Local Engine
# - openai: Requires OpenAI Director
# - gemini: Uses Gemini Director
# - local: Pure deterministic engine (no external network or API keys required)
AI_DIRECTOR_PROVIDER=auto

# 4. Complementary Engines Pass (Master Kill Switch)
# - COMPLEMENTARY_ENGINES_ENABLED: Default false.
#   When false: Theme Context Resolver, Research Broker, and Physical Interaction Planner are strictly OFF.
#   When true: Complementary layer runs according to authority and eligibility rules.
COMPLEMENTARY_ENGINES_ENABLED=false

# 5. Complementary Grounded Research Broker (Subordinate Flag)
# - RESEARCH_ENABLED: Default false. Requires BOTH COMPLEMENTARY_ENGINES_ENABLED=true AND RESEARCH_ENABLED=true.
# - RESEARCH_TIMEOUT_MS: Maximum lookup latency before falling back gracefully (default 4000ms).
# - RESEARCH_PROVIDER: mock | google | local (default: local)
# PRIVACY GUARANTEE: The Research Broker NEVER receives user photos, biometric facial data, or freeform prompts.
# It only processes minimal sanitized payloads: { entity: string, category: AllowedResearchCategory }.
RESEARCH_ENABLED=false
RESEARCH_TIMEOUT_MS=4000
RESEARCH_PROVIDER=local
